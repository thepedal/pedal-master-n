<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless test driver for the engine (no ReBuzz, no WPF): same command
       line and output format as the native machine's tests/harness.cpp, so the
       Python checks in tests/ run against either build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>harness</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../MasterEngine.cs" Link="MasterEngine.cs" />
    <Compile Include="../../Dsp.cs" Link="Dsp.cs" />
    <Compile Include="../../SilenceSleep.cs" Link="SilenceSleep.cs" />
  </ItemGroup>
</Project>
